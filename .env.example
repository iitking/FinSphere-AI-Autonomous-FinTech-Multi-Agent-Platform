# ==============================================================================
# FinSphere AI - Environment Configuration & Customizable Parameters
# ==============================================================================

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME="FinSphere AI"
APP_VERSION="2.0.0"
APP_ENV="development"              # development | staging | production
DEBUG=false
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"                  # DEBUG | INFO | WARNING | ERROR

# ── LLM Engine & API Keys ─────────────────────────────────────────────────────
# Provide your Anthropic API Key below. If left blank or MOCK_MODE=true,
# the system seamlessly executes in offline Simulation Mode using the MockEngine.
ANTHROPIC_API_KEY=""
MODEL="claude-3-7-sonnet-20250219" # Options: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
MAX_TOKENS=4096
TEMPERATURE=0.2
TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
MOCK_MODE=false                    # Set true to force offline simulation mode

# ── Currency & Economic Indicators ───────────────────────────────────────────
BASE_CURRENCY="INR"
USD_TO_INR_RATE=86.50              # Dynamic currency conversion rate
STCG_TAX_RATE=0.20                 # Indian Short-Term Capital Gains Tax (20%)
LTCG_TAX_RATE=0.125                # Indian Long-Term Capital Gains Tax (12.5% per Union Budget)
RISK_FREE_RATE=0.07                # Indian 10-Yr G-Sec Benchmark Yield (7.0%)

# ── Enterprise Guardrail Thresholds ───────────────────────────────────────────
MAX_INPUT_LENGTH=8000              # Max character length for input queries
MIN_OUTPUT_LENGTH=10               # Minimum valid agent response characters
MAX_OUTPUT_LENGTH=16000            # Max output length before safety truncation
STRICT_INPUT_GUARDRAIL=false       # If true, rejects requests with PII instead of sanitizing
ENABLE_PII_REDACTION=true          # Auto-mask sensitive PII
ENABLE_INDIAN_PII=true             # Mask Indian PAN, Aadhaar, Phone, UPI, IFSC
ENABLE_INJECTION_DETECTION=true    # Block prompt injection and instruction overrides
ENABLE_TOPIC_BLOCKING=true         # Block insider trading, money laundering, pump & dump
ENABLE_TOXICITY_BLOCKING=true      # Block unprofessional or abusive outputs

# ── Fraud Detection Rules Parameters ─────────────────────────────────────────
HIGH_AMOUNT_THRESHOLD_INR=100000.0 # High value single transaction review limit (INR)
VELOCITY_WINDOW_MINUTES=5          # Sliding window for velocity burst detection
MAX_TRANSACTIONS_IN_VELOCITY_WINDOW=3 # Max allowed txns in window before alert
MAX_SPEED_KMH_THRESHOLD=800.0      # Speed threshold (km/h) for geo-impossible velocity
NIGHT_HOURS_START=0                # Start of high-risk night window (00:00)
NIGHT_HOURS_END=5                  # End of high-risk night window (05:00)

# ── Risk Assessment Factor Weights (Must Sum to 1.0) ─────────────────────────
MARKET_RISK_WEIGHT=0.30
CREDIT_RISK_WEIGHT=0.25
LIQUIDITY_RISK_WEIGHT=0.20
REGULATORY_RISK_WEIGHT=0.15
OPERATIONAL_RISK_WEIGHT=0.10

# Risk Threshold Brackets (0 - 100 Scale)
RISK_LOW_CUTOFF=30.0               # 0 - 30: Low Risk
RISK_MEDIUM_CUTOFF=60.0            # 31 - 60: Medium Risk
RISK_HIGH_CUTOFF=80.0              # 61 - 80: High Risk (81-100: Critical)

# ── Portfolio Optimization Constraints ────────────────────────────────────────
CONSERVATIVE_EQUITY_CAP=0.30       # Max equity fraction for conservative profile (30%)
MODERATE_EQUITY_CAP=0.60           # Max equity fraction for moderate profile (60%)
AGGRESSIVE_EQUITY_CAP=0.85         # Max equity fraction for aggressive profile (85%)
GOLD_CAP=0.15                      # Max gold / SGB portfolio allocation (15%)
INTERNATIONAL_CAP=0.20             # Max overseas FoF / ETF allocation under RBI LRS (20%)
MIN_ASSET_DIVERSIFICATION_COUNT=4  # Minimum distinct asset classes required
